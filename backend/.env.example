# Vireon Safety Institute — Server Environment Variables
# Copy this file to .env and fill in the actual values

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1
APP_NAME="Vireon Safety Institute API"
FRONTEND_ADMIN_URL=http://localhost:3000
MOBILE_BUNDLE_ID=com.vireon.safety

# ─── Database ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vireon_safety?retryWrites=true&w=majority

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_min_64_chars_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_64_chars_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Cloudinary ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=vireon_unsigned

# ─── Firebase Admin SDK ──────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PROJECT_NUMBER=your_firebase_project_number
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Nodemailer (SMTP) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@vireonsafety.in
SMTP_PASS=your_app_password
SMTP_FROM_NAME="Vireon Safety Institute"
SMTP_FROM_EMAIL=noreply@vireonsafety.in

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ─── Agenda.js (Background Jobs) ─────────────────────────────────────────────
AGENDA_DB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vireon_agenda

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://admin.vireonsafety.in

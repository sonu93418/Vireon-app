# EAS Build Exclude List

# Dependencies & Build Caches
node_modules/
.expo/
.expo-shared/

# Android Native Build Outputs & Caches
android/.gradle/
android/app/build/
android/build/
android/.cxx/
android/app/.cxx/
android/.kotlin/

# Auto-generated Android res PNG files (rebuilt during prebuild)
android/app/src/main/res/drawable-hdpi/
android/app/src/main/res/drawable-mdpi/
android/app/src/main/res/drawable-xhdpi/
android/app/src/main/res/drawable-xxhdpi/
android/app/src/main/res/drawable-xxxhdpi/

# iOS Native Build Outputs & Caches
ios/Pods/
ios/build/
*.xcworkspace
*.xcodeproj

# Lock files (regenerated on build server)
package-lock.json

# Temporary & Local Files
*.log
*.tmp
.DS_Store
Thumbs.db

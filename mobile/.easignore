# EAS Build Exclude List — Drastically reduces upload tarball size from 71MB to 3MB

# Dependencies & Build Caches
node_modules/
.expo/
.expo-shared/

# Android Native Build Outputs & Caches
android/.gradle/
android/app/build/
android/build/
android/.cxx/
android/app/.cxx/

# iOS Native Build Outputs & Caches
ios/Pods/
ios/build/
*.xcworkspace
*.xcodeproj

# Temporary & Local Files
*.log
*.tmp
.DS_Store
Thumbs.db

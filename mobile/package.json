{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --clean",
    "eas-build-pre-install": "node setup-google-services.js",
    "eas-build-post-install": "node setup-google-services.js",
    "postinstall": "node -e \"const fs=require('fs'); const p='node_modules/react-native-worklets/plugin.js'; if(fs.existsSync('node_modules/react-native-worklets/plugin/index.js')) fs.writeFileSync(p, 'module.exports = require(\\'./plugin/index.js\\');');\""
  },
  "dependencies": {
    "@expo/server": "^0.7.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.51.1",
    "ajv": "^8.12.0",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.7.2",
    "buffer": "^6.0.3",
    "expo": "~55.0.25",
    "expo-av": "~16.0.8",
    "expo-clipboard": "~55.0.15",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-device": "~55.0.19",
    "expo-document-picker": "~55.0.15",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-image-picker": "~55.0.22",
    "expo-linear-gradient": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-notifications": "~55.0.25",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-sharing": "~55.0.22",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.20",
    "lucide-react-native": "^1.28.0",
    "nativewind": "^4.1.23",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.52.1",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "^3.1.0",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "react-native-worklets-core": "^1.3.3",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.4"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av"
        ]
      }
    }
  },
